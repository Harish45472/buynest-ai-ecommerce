{
  "name": "ai-ecommerce-website",
  "version": "1.0.0",
  "description": "AI-Powered E-Commerce Platform with Shopping Assistant",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "test": "node server/test-suite.js",
    "audit:images": "node scripts/validateProductImages.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "ai",
    "react",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC"
}
