{
  "name": "ai-ecommerce-website",
  "version": "1.0.0",
  "description": "AI-Powered E-Commerce Platform with Shopping Assistant",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "node server/test-suite.js",
    "audit:images": "node scripts/validateProductImages.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "ai",
    "react",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC"
}
